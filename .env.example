# Copy to .env (or .env.local) and fill in. Never commit the filled-in file.
#
# Only NEXT_PUBLIC_* values are safe to expose: Next.js inlines them into the
# JavaScript bundle that every visitor downloads. Everything else here is a
# secret and must NOT carry that prefix.

# --- Public (safe in the browser bundle) -------------------------------------

# reCAPTCHA v3 site key. Public by design.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Secrets (server only) ---------------------------------------------------

# reCAPTCHA v3 secret key, used for server-side token verification.
RECAPTCHA_SECRET_KEY=

# Password for /private and /resumeimport. Verified on the server only.
ADMIN_PASSWORD=

# HMAC key that signs the admin session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this invalidates all existing admin sessions.
ADMIN_SESSION_SECRET=

# Firebase Admin service account.
# Firebase console > Project settings > Service accounts > Generate new private key.
# Either provide the whole JSON in one variable:
# FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}
# ...or the three fields separately (keep the \n escapes in the private key):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Brevo SMTP relay credentials, used for contact-form email.
BREVO_SMTP_USER=
BREVO_SMTP_KEY=

# Where new contact submissions are announced. Unset = no notification sent.
CONTACT_NOTIFY_TO=

# Sender address for contact email. Must be a verified sender in Brevo.
CONTACT_FROM_EMAIL=
