rules_version = '2';

// Deny-all baseline.
//
// Every Firestore access in this project goes through the Firebase Admin SDK on
// the server (src/lib/firebaseAdmin.ts). The Admin SDK authenticates as a
// service account and bypasses these rules, so denying everything here costs the
// app nothing and closes direct browser/REST access.
//
// This matters because the web config (including the project id) is public by
// design. While the app used the *client* SDK, `contacts` had to allow
// unauthenticated reads and writes for the site to work — which meant anyone
// could list every contact submission straight from Firestore's REST API.
//
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
